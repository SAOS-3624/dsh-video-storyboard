{
  "name": "dsh-video-storyboard",
  "version": "0.7.1",
  "description": "Turn a video into storyboard images you can cite: one frame per shot, cell size follows cut density (1/1 … 1/8), row-packed into as few images as possible, with a timestamped index the model can quote and a tier map it can override.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "storyboard",
    "contact-sheet",
    "shot-detection",
    "scene-detection",
    "ffmpeg",
    "multimodal",
    "asr"
  ],
  "homepage": "https://github.com/SAOS-3624/dsh-video-storyboard#readme",
  "bugs": {
    "url": "https://github.com/SAOS-3624/dsh-video-storyboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/dsh-video-storyboard.git"
  },
  "author": "SAOS-3624",
  "contributors": [
    {
      "name": "ggfgfgf-on",
      "url": "https://github.com/ggfgfgf-on"
    },
    {
      "name": "dugu951",
      "url": "https://github.com/dugu951"
    },
    {
      "name": "canyueY",
      "url": "https://github.com/canyueY"
    },
    {
      "name": "xingyueDanYang",
      "url": "https://github.com/xingyueDanYang"
    },
    {
      "name": "aizhimoran",
      "url": "https://github.com/aizhimoran"
    },
    {
      "name": "MULINXF",
      "url": "https://github.com/MULINXF"
    },
    {
      "name": "viwe-monai",
      "url": "https://github.com/viwe-monai"
    },
    {
      "name": "opcXopc",
      "url": "https://github.com/opcXopc"
    }
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./plan": "./src/storyboard/plan.js",
    "./scan": "./src/storyboard/scan.js",
    "./segments": "./src/storyboard/segments.js",
    "./probe": "./src/storyboard/probe.js",
    "./sheet": "./src/storyboard/sheet.js",
    "./frames": "./src/storyboard/frames.js",
    "./format": "./src/storyboard/format.js",
    "./pipeline": "./src/storyboard/pipeline.js",
    "./tool-spec": "./src/tool-spec.js",
    "./storyboard": "./src/storyboard/index.js",
    "./board": "./src/storyboard/board.js",
    "./cache": "./src/storyboard/cache.js",
    "./storage": "./src/storyboard/storage.js",
    "./locate": "./src/storyboard/locate.js",
    "./subtitles": "./src/storyboard/subtitles.js",
    "./ytdlp": "./src/storyboard/ytdlp.js",
    "./python": "./src/storyboard/python.js",
    "./browser-time": "./src/storyboard/browser-time.js",
    "./transcript-pass": "./src/storyboard/transcript-pass.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-video-scan": "./bin/scan-video.mjs",
    "dsh-video-storyboard": "./bin/storyboard.mjs",
    "dsh-video-doctor": "./bin/doctor.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "scripts",
    "docs",
    "locale",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "CREDITS.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node scripts/guard-publish.mjs && npm test",
    "check": "node scripts/check-syntax.mjs",
    "doctor": "node bin/doctor.mjs",
    "asrcheck": "node bin/asr-check.mjs",
    "guard": "node scripts/guard-publish.mjs",
    "verify-tokens": "node scripts/verify-image-tokens.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
