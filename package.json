{
  "name": "dsh-video-storyboard",
  "version": "0.3.0",
  "description": "Scene-aware storyboard for DeepSeek Harness: one addressable grid per video (numbered cells, timestamps, transcript, audio envelope) so a text-only agent can look at the video itself instead of being told a summary.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "storyboard",
    "contact-sheet",
    "ffmpeg",
    "multimodal",
    "asr"
  ],
  "homepage": "https://github.com/SAOS-3624/dsh-video-storyboard#readme",
  "bugs": {
    "url": "https://github.com/SAOS-3624/dsh-video-storyboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/dsh-video-storyboard.git"
  },
  "author": "SAOS-3624",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./plan": "./src/plan.js",
    "./scan": "./src/scan.js",
    "./segments": "./src/segments.js",
    "./probe": "./src/probe.js",
    "./sheet": "./src/sheet.js",
    "./pipeline": "./src/pipeline.js",
    "./analyze": "./src/analyze.js",
    "./plan-storyboard": "./src/plan-storyboard.js",
    "./render": "./src/render.js",
    "./candidates": "./src/candidates.js",
    "./memory-adapter": "./src/memory-adapter.js",
    "./tool-spec": "./src/tool-spec.js",
    "./enrichment": "./src/enrichment/index.js"
  },
  "bin": {
    "dsh-video-scan": "./bin/scan-video.mjs",
    "dsh-video-storyboard": "./bin/storyboard.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "docs",
    "extras",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "CREDITS.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "check": "node scripts/syntax-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
